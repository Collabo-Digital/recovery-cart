{% comment %}
  Recovery Cart App Configuration
  
  This block loads widget settings from an app-owned metafield:
  - Namespace: app (app-owned metafield)
  - Key: settings
  - Type: json
  
  Access path: shop.metafields.app.settings
  
  The metafield is defined in shopify.app.toml and written via Admin API.
{% endcomment %}

{% assign app_config = shop.metafields.app--313201623041.settings.value %}

<script>
  (function() {
  
    
    // Parse the actual settings from metafield
    const savedSettings = {{ app_config | json }};

    // Default fallback settings
    const defaultSettings = {
      position: "bottom-right",
      phoneNumber: "",
      buttonText: "Chat with us",
      buttonColor: {
        hue: 142,
        saturation: 0.77,
        brightness: 0.75
      }
    };

    // Determine which settings to use
    const finalSettings = savedSettings || defaultSettings;

    // Create global config for the widget
    window.__recovery_cart_config__ = {
      shop: {{ shop.permanent_domain | json }},
      widgetSettings: finalSettings,
      isActive: !!savedSettings,
      debug: {
        metafieldExists: {% if app_config %}true{% else %}false{% endif %},
        metafieldValue: {{ app_config.value | json }},
        usingDefaults: !savedSettings
      }
    };

  })();
</script>

{% schema %}
{
  "name": "Recovery Cart",
  "target": "head"
}
{% endschema %}

<script defer src="https://recovery-cart.vercel.app/widgets/recovery-cart-widget.iife.js"></script>