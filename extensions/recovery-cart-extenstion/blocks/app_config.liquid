{% comment %}
  Recovery Cart App Configuration
  
  This block loads widget settings from an app-owned metafield:
  - Namespace: app (app-owned metafield)
  - Key: settings
  - Type: json
  
  Access path: shop.metafields.app.settings
  
  The metafield is defined in shopify.app.toml and written via Admin API.
{% endcomment %}

{% assign app_config = shop.metafields.app--313201623041.settings.value %}

<script>
  (function() {
    // Debug: Log the raw metafield object (for development)
    console.group('🔍 Recovery Cart Metafield Debug');
    console.log('1. Raw metafield object:', {{ app_config | json }});
    console.log('2. Metafield value (parsed):', {{ app_config.value | json }});
    console.log('3. Metafield type:', {{ app_config.type | json }});
    console.log('4. Shop domain:', {{ shop.permanent_domain | json }});
    
    // Parse the actual settings from metafield
    const savedSettings = {{ app_config | json }};
    console.log('5. Parsed savedSettings:', savedSettings);

    // Default fallback settings
    const defaultSettings = {
      position: "bottom-right",
      phoneNumber: "",
      buttonText: "Chat with us",
      buttonColor: {
        hue: 142,
        saturation: 0.77,
        brightness: 0.75
      }
    };

    // Determine which settings to use
    const finalSettings = savedSettings || defaultSettings;
    console.log('6. Final settings (saved or default):', finalSettings);
    console.log('7. Using saved settings?', !!savedSettings);

    // Create global config for the widget
    window.__recovery_cart_config__ = {
      shop: {{ shop.permanent_domain | json }},
      widgetSettings: finalSettings,
      isActive: !!savedSettings,
      debug: {
        metafieldExists: {% if app_config %}true{% else %}false{% endif %},
        metafieldValue: {{ app_config.value | json }},
        usingDefaults: !savedSettings
      }
    };

    console.log('8. Global config created:', window.__recovery_cart_config__);
    console.groupEnd();

    // Warning if no metafield found
    if (!savedSettings) {
      console.warn(
        '⚠️ No metafield found at shop.metafields.app.settings\n' +
        'Expected namespace: "app" (app-owned)\n' +
        'Expected key: "settings"\n' +
        'Using default settings instead.\n\n' +
        'To fix:\n' +
        '1. Ensure metafield is defined in shopify.app.toml\n' +
        '2. Deploy: npm run deploy\n' +
        '3. Save settings in your app admin'
      );
    }
  })();
</script>

{% schema %}
{
  "name": "Recovery Cart",
  "target": "head"
}
{% endschema %}

<script defer src="https://app.recoverycart.com/widgets/recovery-cart-widget.iife.js"></script>